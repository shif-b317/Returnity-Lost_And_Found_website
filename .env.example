# RETURNITY Environment Configuration Template
# Copy this file to .env and adjust variables as required

SECRET_KEY=change-this-to-a-secure-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=returnity_db

# File Upload Settings
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=uploads/items
EVIDENCE_FOLDER=uploads/evidence

# Default Administrator Seed Configuration
ADMIN_NAME=Returnity Administrator
ADMIN_EMAIL=admin@returnity.org
ADMIN_PASSWORD=AdminReturnity2026!
ADMIN_PHONE=9876543210
